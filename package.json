{
  "name": "@hukt-labs/resolver",
  "version": "0.1.0",
  "description": "One-line integration for Token-2022 transfer-hook tokens: resolve a mint's extra accounts and build transfer instructions with the hook accounts injected.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "solana",
    "token-2022",
    "transfer-hook",
    "spl-token",
    "extra-account-metas"
  ],
  "author": "hukt-labs",
  "license": "MIT",
  "homepage": "https://github.com/HuktYard/hukt-resolver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuktYard/hukt-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/HuktYard/hukt-resolver/issues"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
